# ═══════════════════════════════════════════════════════════════════════
#  GRAYSENTINEL VULNINTEL v4.0 — Environment Configuration
# ═══════════════════════════════════════════════════════════════════════
#  
#  USAGE:
#    cp .env.example .env
#    # Edit .env, fill in REQUIRED values
#    # Never commit .env to git
#  
#  GENERATE SECRETS:
#    python3 -c 'import secrets; print(secrets.token_urlsafe(48))'
#    openssl rand -base64 48
#  
# ═══════════════════════════════════════════════════════════════════════

# ─── Server ───────────────────────────────────────────────────────────
VULN_HOST=127.0.0.1
VULN_PORT=5000
VULN_DB=vulnintel.db
VULN_LOG_DIR=logs

# ─── Security — CHANGE THESE BEFORE FIRST RUN ─────────────────────────
# REQUIRED: Random 48+ chars
VULN_SECRET_KEY=CHANGE_ME_REQUIRED_48_PLUS_CHARACTERS_RANDOM_STRING

# REQUIRED: Random salt for Fernet key derivation
VULN_FERNET_SALT=CHANGE_ME_REQUIRED_RANDOM_SALT

# ─── Admin Bootstrap (First Run Only) ─────────────────────────────────
# These are used only when database is first created.
# After that, manage users via /admin UI.
VULN_ADMIN_USER=admin

# REQUIRED: Change to strong random password (16+ chars)
VULN_ADMIN_PASS=CHANGE_ME_BEFORE_FIRST_RUN

# ─── Data Retention (Days) ────────────────────────────────────────────
VULN_RETENTION_FINDINGS=365
VULN_RETENTION_EVIDENCE=90

# ─── Scheduler ────────────────────────────────────────────────────────
# Hours between automatic scans of active targets
VULN_SCAN_INTERVAL_HOURS=6

# ─── Backup ───────────────────────────────────────────────────────────
VULN_BACKUP_DIR=backups

# ─── Optional: External APIs ──────────────────────────────────────────
# VULN_NVD_API_KEY=                       # NVD rate limit: 5/30s without key, 50/30s with key
# VULN_SHODAN_API_KEY=                    # Reserved for v4.1
# VULN_VIRUSTOTAL_API_KEY=                # Reserved for v4.1

# ─── Optional: Database (PostgreSQL) ──────────────────────────────────
# If set, overrides VULN_DB (SQLite) path
# VULN_DB_URL=postgresql://user:pass@localhost:5432/vulnintel

# ─── Optional: Logging ────────────────────────────────────────────────
# VULN_LOG_LEVEL=INFO                     # DEBUG | INFO | WARNING | ERROR
# VULN_LOG_MAX_BYTES=10485760             # 10 MB per file
# VULN_LOG_BACKUP_COUNT=5                 # Keep 5 rotated files

# ─── Optional: Scanning ───────────────────────────────────────────────
# VULN_MAX_CONCURRENT_SCANS=4             # ThreadPool workers
# VULN_MAX_FINDINGS_PER_SCAN=5000         # Prevent DB flood
# VULN_MAX_KATANA_RESULTS=200             # Cap crawling

# ═══════════════════════════════════════════════════════════════════════
#  SECURITY NOTES
# ═══════════════════════════════════════════════════════════════════════
#  
#  • .env is gitignored — never commit it
#  • Rotate VULN_SECRET_KEY every 90 days
#  • Rotating VULN_FERNET_SALT invalidates stored encrypted values
#  • Use `docker secrets` or Vault in production, not .env files
#  • After first login: change admin password via /admin UI
#  • Enable 2FA for all admin accounts immediately
#  
# ═══════════════════════════════════════════════════════════════════════
